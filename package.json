{
  "name": "indonesia-urban-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "data:boundaries": "node scripts/import-boundaries.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "data:boundaries:upload": "node scripts/import-supplied-boundaries.mjs",
    "data:validate:release": "node scripts/validate-data.mjs --require-publishable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
