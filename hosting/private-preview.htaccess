# IUI PRIVATE PREVIEW — deny access until site-specific authentication is configured.
# This file belongs ONLY in the NEW domain's document root.
Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Cache-Control "no-store"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
# Keep this deny rule until Hostinger directory password protection is configured
# and verified on the NEW site's root, assets, and data paths.
Require all denied
